<odoo>


<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">olive_config_settings_form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="/form" position="inside">
            <app name="olive_mill" data-string="Olive Mill" string="Olive Mill" data-key="olive_mill" groups="stock.group_stock_manager">
                <block title="Optional Features" id="olive_mill_groups">
                    <setting id="group_olive_organic" help="For olive mills that have an organic certification and produce both organic and non-organic olive oil">
                        <field name="group_olive_organic"/>
                    </setting>
                    <setting id="group_olive_protected_geo_indication" help="For olive mills that produce olive oil for a protected geographical indication (or several)." >
                        <field name="group_olive_protected_geo_indication"/>
                    </setting>
                    <setting id="group_oil_ratio_modulation_per_olive_variant" help="Allow to modulate the olive oil ratio per olive variant. The modulation coefficient must be configured on each olive variant." >
                        <field name="group_oil_ratio_modulation_per_olive_variant"/>
                    </setting>
                </block>
                <block title="Variables" id="olive_mill_variables">
                    <setting id="current_season_id">
                        <field name="current_season_id"/>
                    </setting>
                    <setting id="olive_oil_density">
                        <field name="olive_oil_density" class="oe_inline"/><span> kg / L</span>
                    </setting>
                    <setting id="olive_max_qty_per_palox">
                        <field name="olive_max_qty_per_palox" class="oe_inline"/><span> kg</span>
                    </setting>
                    <setting id="olive_shrinkage_ratio">
                        <field name="olive_shrinkage_ratio" /><span> %</span>
                    </setting>
                    <setting id="olive_filter_ratio">
                        <field name="olive_filter_ratio"/><span> %</span>
                    </setting>
                    <setting id="olive_min_ratio">
                        <field name="olive_min_ratio"/><span> %</span>
                    </setting>
                    <setting id="olive_max_ratio">
                        <field name="olive_max_ratio"/><span> %</span>
                    </setting>
                    <setting id="olive_harvest_arrival_max_delta_days">
                        <field name="olive_harvest_arrival_max_delta_days"/><span> days</span>
                    </setting>
                </block>
                <block title="Pre-season Polls" id="olive_mill_polls">
                    <setting id="olive_preseason_poll_ratio_no_history">
                        <field name="olive_preseason_poll_ratio_no_history"/><span> %</span>
                    </setting>
                </block>
                <block title="Appointments" id="olive_mill_appointments">
                    <setting id="olive_appointment_qty_per_palox">
                        <field name="olive_appointment_qty_per_palox"/><span> kg</span>
                    </setting>
                    <setting id="olive_appointment_arrival_no_leaf_removal_minutes">
                        <field name="olive_appointment_arrival_no_leaf_removal_minutes"/><span> minutes / 100 kg of olive</span>
                    </setting>
                    <setting id="olive_appointment_arrival_leaf_removal_minutes">
                        <field name="olive_appointment_arrival_leaf_removal_minutes"/><span> minutes / 100 kg of olive</span>
                    </setting>
                    <setting id="olive_appointment_arrival_min_minutes">
                        <field name="olive_appointment_arrival_min_minutes"/><span> minutes</span>
                    </setting>
                    <setting id="olive_appointment_lend_minutes">
                        <field name="olive_appointment_lend_minutes"/><span> minutes</span>
                    </setting>
                    <setting id="olive_appointment_withdrawal_minutes">
                        <field name="olive_appointment_withdrawal_minutes"/><span> minutes</span>
                    </setting>
                </block>
                <block title="Oil Production" id="olive_mill_production">
                    <setting id="olive_oil_production_result_uom">
                        <field name="olive_oil_production_result_uom"/>
                    </setting>
                    <setting id="olive_oil_production_multipalox_result">
                        <field name="olive_oil_production_multipalox_result"/>
                    </setting>
                    <setting id="olive_oil_production_start_hour">
                        <field name="olive_oil_production_start_hour"/><span> h</span>
                    </setting>
                    <setting id="olive_oil_production_start_minute">
                        <field name="olive_oil_production_start_minute"/><span> min</span>
                    </setting>
                    <setting id="olive_oil_production_duration_minutes">
                        <field name="olive_oil_production_duration_minutes"/><span> minutes</span>
                    </setting>
                </block>
                <block title="Invoicing" id="olive_mill_invoice">
                    <setting id="olive_oil_leaf_removal_product_id">
                        <field name="olive_oil_leaf_removal_product_id"/>
                    </setting>
                    <setting id="olive_oil_production_product_id">
                        <field name="olive_oil_production_product_id"/>
                    </setting>
                    <setting id="olive_oil_tax_product_id">
                        <field name="olive_oil_tax_product_id"/>
                    </setting>
                </block>
                <block title="Analysis" id="olive_mill_analysis">
                    <setting id="olive_oil_analysis_default_user_id">
                        <field name="olive_oil_analysis_default_user_id"/>
                    </setting>
                </block>
            </app>
        </xpath>
    </field>
</record>

<record id="res_config_settings_action" model="ir.actions.act_window">
    <field name="name">Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">inline</field>
    <field name="context">{'module' : 'olive_mill', 'bin_size': False}</field>
</record>

<menuitem id="res_config_settings_menu"
        action="res_config_settings_action"
        parent="olive_config_menu"
        groups="base.group_system"
        sequence="10"/>


</odoo>
