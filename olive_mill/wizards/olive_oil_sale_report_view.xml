<odoo>

        <record id="olive_oil_sale_report_form" model="ir.ui.view">
                <field name="model">olive.oil.sale.report</field>
                <field name="arch" type="xml">
                        <form>
                            <div>Statistics on the sale of olive oil. All quantities are in liter.</div>
                            <group name="main">
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                            </group>
                                    <footer>
                                            <button type="object" string="Show" name="run" class="btn-primary"/>
                                            <button special="cancel" string="Close" class="btn-default"/>
                                    </footer>
                            </form>
                    </field>
            </record>

            <record id="olive_oil_sale_report_action" model="ir.actions.act_window">
                    <field name="name">Olive Oil Sale Report</field>
                    <field name="res_model">olive.oil.sale.report</field>
                    <field name="view_mode">form</field>
                    <field name="target">new</field>
            </record>

            <menuitem id="olive_oil_sale_report_menu" action="olive_oil_sale_report_action" sequence="30" parent="olive_report_menu"/>

            <!-- LINES -->
            <record id="olive_oil_sale_report_line_tree" model="ir.ui.view">
                <field name="model">olive.oil.sale.report.line</field>
                <field name="arch" type="xml">
                        <list>
                                <field name="parent_id" invisible="1"/>
                                <field name="date"/>
                                <field name="oil_product_id"/>
                                <field name="olive_culture_type" optional="show"/>
                                <field name="loose_qty" sum="1" optional="show"/>
                                <field name="in_bottle_qty" sum="1" optional="show"/>
                                <field name="total_qty" sum="1"/>
                        </list>
                    </field>
            </record>

            <record id="olive_oil_sale_report_line_pivot" model="ir.ui.view">
                <field name="model">olive.oil.sale.report.line</field>
                <field name="arch" type="xml">
                        <pivot>
                                <field name="date" interval="month" type="col"/>
                                <field name="oil_product_id" type="row"/>
                                <field name="total_qty" type="measure"/>
                        </pivot>
                    </field>
            </record>
            <record id="olive_oil_sale_report_line_graph" model="ir.ui.view">
                <field name="model">olive.oil.sale.report.line</field>
                <field name="arch" type="xml">
                        <graph>
                                <field name="oil_product_id"/>
                                <field name="total_qty" type="measure"/>
                        </graph>
                    </field>
            </record>
            <record id="olive_oil_sale_report_line_search" model="ir.ui.view">
                <field name="model">olive.oil.sale.report.line</field>
                <field name="arch" type="xml">
                    <search>
                        <field name="oil_product_id"/>
                        <field name="date"/>
                        <separator/>
                        <filter string="Date" name="date" date="date"/>
                        <separator/>
                        <filter name="olive_culture_type_regular" domain="[('olive_culture_type', '=', 'regular')]" string="Regular"/>
                        <filter name="olive_culture_type_conversion" domain="[('olive_culture_type', '=', 'conversion')]" string="Conversion"/>
                        <filter name="olive_culture_type_organic" domain="[('olive_culture_type', '=', 'organic')]" string="Organic"/>
                        <group name="groupby">
                            <filter name="olive_culture_type_groupby" string="Olive Culture Type" context="{'group_by': 'olive_culture_type'}"/>
                            <filter name="date_groupby" string="Date" context="{'group_by': 'date'}"/>
                        </group>
                    </search>
                </field>
        </record>
            <record id="olive_oil_sale_report_line_action" model="ir.actions.act_window">
                    <field name="name">Olive Oil Sale Statistics</field>
                    <field name="res_model">olive.oil.sale.report.line</field>
                    <field name="view_mode">pivot,graph,list</field>
                    <!-- domain to filter on the result of a specific wizard is added by code -->
            </record>


</odoo>
