<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="olive_oil_bottling_form" model="ir.ui.view">
    <field name="name">olive.oil.bottling.form</field>
    <field name="model">olive.oil.bottling</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <field name="state" widget="statusbar"/>
            </header>
            <group name="main">
                <field name="company_id" invisible="1"/>
                <field name="bottle_product_id" readonly="state != 'select'"/>
                <field name="season_id" readonly="state != 'select'"/>
                <field name="warehouse_id" invisible="state != 'select'"/>
            </group>
            <group name="qty_tank" invisible="state not in ('qty', 'produce')">
                <label for="bottle_volume"/>
                <div name="bottle_volume">
                    <field name="bottle_volume" class="oe_inline"/> L
                </div>
                <field name="bom_id"/>
                <field name="oil_product_id"/>
                <field name="bottle_qty" required="state == 'qty'" readonly="state != 'qty'"/>
                <field name="src_location_id" required="state == 'qty'" readonly="state != 'qty'"/>
                <field name="src_location_end_status" required="state == 'qty'" widget="radio" readonly="state != 'qty'"/>
                <field name="other_src_location_id" required="state == 'qty'" readonly="state != 'qty'"/>
                <field name="dest_location_id" required="state == 'qty'" readonly="state != 'qty'"/>
            </group>
            <group name="inventory_lot" invisible="state != 'produce'">
                <label for="src_location_start_qty"/>
                <div name="src_location_start_qty">
                    <field name="src_location_start_qty" class="oe_inline"/> L
                </div>
                <label for="oil_qty"/>
                <div name="oil_qty">
                    <field name="oil_qty" class="oe_inline"/> L
                </div>
                <label for="src_location_end_qty"/>
                <div name="src_location_end_qty">
                    <field name="src_location_end_qty" class="oe_inline"/> L
                </div>
                <field name="inventory_required"/>
                <label for="inventory_start_qty" invisible="inventory_required == 'no'"/>
                <div name="inventory_start_qty" invisible="inventory_required == 'no'">
                    <field name="inventory_start_qty" class="oe_inline"/> L
                </div>
                <label for="inventory_end_qty" invisible="inventory_required == 'no'"/>
                <div name="inventory_end_qty" invisible="inventory_required == 'no'">
                    <field name="inventory_end_qty" class="oe_inline"/> L
                </div>
                <field name="lot_type" required="state == 'produce'" widget="radio"/>
                <field name="expiry_date" required="state == 'produce' and lot_type == 'new'"/>
                <field name="lot_name" required="state == 'produce' and lot_type == 'new'" invisible="lot_type != 'new'"/>
                <field name="lot_id" required="state == 'produce' and lot_type == 'existing'" invisible="lot_type != 'existing'"/>
            </group>
            <footer>
                <!--TODO: Result from converting "states='select'" attribute into an 'invisible' attribute
                     Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                <button name="select2qty" type="object" string="Next" class="btn-primary" invisible="state not in ['select']"/>
                <!--TODO: Result from converting "states='qty'" attribute into an 'invisible' attribute
                     Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                <button name="qty2produce" type="object" string="Next" class="btn-primary" invisible="state not in ['qty']"/>
                <!--TODO: Result from converting "states='produce'" attribute into an 'invisible' attribute
                     Manually combine states condition into any 'invisible' overrides in inheriting views as well-->
                <button name="validate" type="object" string="Validate" class="btn-primary" invisible="state not in ['produce']"/>
                <button special="cancel" string="Cancel" class="btn-default"/>
            </footer>
        </form>
    </field>
</record>

<record id="olive_oil_bottling_action" model="ir.actions.act_window">
    <field name="name">Olive Oil Bottling</field>
    <field name="res_model">olive.oil.bottling</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem id="olive_oil_bottling_menu" action="olive_oil_bottling_action" parent="olive_operations_menu" sequence="220"/>

</odoo>
