<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="view_production_lot_form" model="ir.ui.view">
    <field name="name">oil_mill_stock_lot_form</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
        <field name="product_id" position="after">
            <field name="olive_production_id" invisible="product_detailed_type != 'olive_oil'"/>
            <field name="product_detailed_type" invisible="1"/>
        </field>
        <sheet position="before">
            <header>
                <button type="action" name="%(olive_prodlot_tracability_report)d" string="Olive Oil Tracability Report" invisible="product_detailed_type != 'olive_oil'"/>
            </header>
        </sheet>
    </field>
</record>

<record id="search_product_lot_filter" model="ir.ui.view">
    <field name="name">olive.stock.lot.search</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.search_product_lot_filter"/>
    <field name="arch" type="xml">
        <field name="product_id" position="after">
            <separator/>
            <filter domain="[('product_detailed_type', '=like', 'olive_%')]" string="Olive Products" name="olive_products"/>
        </field>
    </field>
</record>

<record id="olive_stock_production_lot_action" model="ir.actions.act_window">
    <field name="name">Lots</field>
    <field name="res_model">stock.lot</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_olive_products': True}</field>
</record>

<menuitem id="olive_stock_production_lot_menu" action="olive_stock_production_lot_action" parent="olive_data_menu" sequence="120"/>


</odoo>
