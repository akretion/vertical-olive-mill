<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="olive_oil_analysis_form" model="ir.ui.view">
    <field name="name">olive.oil.analysis.form</field>
    <field name="model">olive.oil.analysis</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="validate" invisible="state != 'draft'" string="Validate" type="object" class="btn-primary"/>
                <button name="back2draft" invisible="state != 'cancel'" string="Back to Draft" type="object"/>
                <button name="%(olive_oil_analysis_report)d" invisible="state != 'done'" string="Print Report" type="action" class="btn-primary"/>
                <button name="cancel" invisible="state != 'done'" string="Cancel" type="object" confirm="Are you sure you want to cancel this analysis?"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
            </header>
            <sheet>
                <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                <group name="main">
                    <group name="main-left">
                        <field name="oil_source_type" widget="radio" readonly="state == 'done'"/>
                        <field name="arrival_line_id" invisible="oil_source_type != 'arrival'" required="oil_source_type == 'arrival'" readonly="state == 'done'"/>
                        <field name="location_id" invisible="oil_source_type != 'tank'" required="oil_source_type == 'tank'" readonly="state == 'done'"/>
                        <field name="season_id" readonly="state == 'done'"/>
                        <field name="oil_product_id" readonly="state == 'done'"/>
                        <field name="lot_id" invisible="oil_source_type != 'tank'" readonly="state == 'done'"/>
                        <field name="date" options="{'datepicker': {'warn_future': true}}" readonly="state == 'done'"/>
                        <field name="execution_mode" readonly="state == 'done'"/>
                        <field name="execution_user_id" invisible="execution_mode != 'internal'" readonly="state == 'done'"/>
                        <field name="execution_partner_id" invisible="execution_mode != 'external'" string="Analysis Made by" readonly="state == 'done'"/>
                    </group>
                    <group name="main-right">
                        <field name="partner_id" invisible="oil_source_type != 'arrival'"/>
                        <field name="arrival_date" invisible="oil_source_type != 'arrival'"/>
                        <field name="production_id" invisible="oil_source_type != 'arrival'"/>
                        <field name="production_date" invisible="oil_source_type != 'arrival'"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="state == 'done'"/>
                    </group>
                </group>
                <group name="lines" string="Results">
                    <field name="line_ids" nolabel="1" readonly="state == 'done'"/>
                </group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<record id="olive_oil_analysis_tree" model="ir.ui.view">
    <field name="name">olive.oil.analysis.tree</field>
    <field name="model">olive.oil.analysis</field>
    <field name="arch" type="xml">
        <list>
            <field name="name" decoration-bf="1"/>
            <field name="oil_source_type" widget="badge" decoration-warning="oil_source_type == 'tank'" decoration-danger="oil_source_type == 'arrival'"/>
            <field name="partner_id"/>
            <field name="location_id" invisible="oil_source_type != 'tank'"/>
            <field name="oil_product_id"/>
            <field name="lot_id" optional="hide"/>
            <field name="season_id" optional="show"/>
            <field name="date"/>
            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'"/>
        </list>
    </field>
</record>

<record id="olive_oil_analysis_search" model="ir.ui.view">
    <field name="name">olive.oil.analysis.search</field>
    <field name="model">olive.oil.analysis</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="partner_id"/>
            <field name="location_id"/>
            <field name="oil_product_id"/>
            <field name="lot_id"/>
            <separator/>
            <filter name="current_season" string="Current Season" domain="[('current_season', '=', True)]"/>
            <separator/>
            <filter name="draft" domain="[('state', '=', 'draft')]" string="Draft"/>
            <filter name="done" domain="[('state', '=', 'done')]" string="Done"/>
            <separator/>
            <filter name="arrival" domain="[('oil_source_type', '=', 'arrival')]" string="Arrival"/>
            <filter name="tank" domain="[('oil_source_type', '=', 'tank')]" string="Tank"/>
            <separator/>
            <filter name="internal" domain="[('execution_mode', '=', 'internal')]" string="Internal"/>
            <filter name="external" domain="[('execution_mode', '=', 'external')]" string="External"/>
            <separator/>
            <group name="groupby">
                <filter name="state_groupby" string="State" context="{'group_by': 'state'}"/>
                <filter name="oil_product_groupby" string="Oil Product" context="{'group_by': 'oil_product_id'}"/>
                <filter name="partner_groupby" string="Olive Farmer" context="{'group_by': 'partner_id'}"/>
                <filter name="location_groupby" string="Oil Tank" context="{'group_by': 'location_id'}"/>
                <filter name="season_groupby" string="Season" context="{'group_by': 'season_id'}"/>
                <filter name="date_groupby" string="Date" context="{'group_by': 'date:month'}"/>
            </group>
        </search>
    </field>
</record>

<record id="olive_oil_analysis_action" model="ir.actions.act_window">
    <field name="name">Oil Analysis</field>
    <field name="res_model">olive.oil.analysis</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_current_season': True}</field>
</record>

<menuitem id="olive_oil_analysis_menu" action="olive_oil_analysis_action" parent="olive_operations_menu" sequence="230"/>

<record id="olive_oil_analysis_line_form" model="ir.ui.view">
    <field name="name">olive.oil.analysis.line.form</field>
    <field name="model">olive.oil.analysis.line</field>
    <field name="arch" type="xml">
        <form string="Olive Oil Analysis Line">
            <group name="main">
                <field name="analysis_id" invisible="not context.get('olive_oil_analysis_line_main_view')"/>
                <field name="product_id"/>
                <field name="result_p1" invisible="decimal_precision != 1"/>
                <field name="result_p2" invisible="decimal_precision != 2"/>
                <field name="result_int" invisible="decimal_precision != 0"/>
                <field name="uom"/>
                <field name="precision"/>
                <field name="instrument"/>
                <field name="state" invisible="1"/>
                <field name="decimal_precision" invisible="1"/>
            </group>
        </form>
    </field>
</record>

<record id="olive_oil_analysis_line_tree" model="ir.ui.view">
    <field name="name">olive.oil.analysis.line.tree</field>
    <field name="model">olive.oil.analysis.line</field>
    <field name="arch" type="xml">
        <list string="Olive Oil Analysis Lines">
            <field name="analysis_id" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="product_id"/>
            <field name="oil_product_id" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="partner_id" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="location_id" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="date" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="season_id" column_invisible="not context.get('olive_oil_analysis_line_main_view')"/>
            <field name="result_string"/>
            <field name="uom"/>
            <field name="precision" column_invisible="context.get('olive_oil_analysis_line_main_view')"/>
            <field name="instrument" column_invisible="context.get('olive_oil_analysis_line_main_view')"/>
            <field name="state" column_invisible="1"/>
        </list>
    </field>
</record>

<record id="olive_oil_analysis_line_search" model="ir.ui.view">
    <field name="name">olive.oil.analysis.line.search</field>
    <field name="model">olive.oil.analysis.line</field>
    <field name="arch" type="xml">
        <search>
            <field name="oil_product_id"/>
            <separator/>
            <filter name="draft" domain="[('state', '=', 'draft')]" string="Draft"/>
            <filter name="done" domain="[('state', '=', 'done')]" string="Done"/>
            <separator/>
            <filter name="arrival" domain="[('oil_source_type', '=', 'arrival')]" string="Arrival"/>
            <filter name="tank" domain="[('oil_source_type', '=', 'tank')]" string="Tank"/>
            <separator/>
            <filter name="internal" domain="[('execution_mode', '=', 'internal')]" string="Internal"/>
            <filter name="external" domain="[('execution_mode', '=', 'external')]" string="External"/>
            <separator/>
            <filter name="current_season" string="Current Season" domain="[('current_season', '=', True)]"/>
            <separator/>
            <group name="groupby">
                <filter name="state_groupby" string="State" context="{'group_by': 'state'}"/>
                <filter name="oil_product_groupby" string="Oil Product" context="{'group_by': 'oil_product_id'}"/>
                <filter name="partner_groupby" string="Olive Farmer" context="{'group_by': 'partner_id'}"/>
                <filter name="location_groupby" string="Oil Tank" context="{'group_by': 'location_id'}"/>
                <filter name="season_groupby" string="Season" context="{'group_by': 'season_id'}"/>
                <filter name="date_groupby" string="Date" context="{'group_by': 'date:month'}"/>
            </group>
        </search>
    </field>
</record>

<record id="olive_oil_analysis_line_pivot" model="ir.ui.view">
    <field name="name">olive.oil.analysis.line.pivot</field>
    <field name="model">olive.oil.analysis.line</field>
    <field name="arch" type="xml">
        <pivot>
            <field name="oil_product_id" type="row"/>
            <field name="product_id" type="col"/>
            <field name="result_p1" type="measure"/>
            <field name="result_p2" type="measure"/>
            <field name="result_int" type="measure"/>
        </pivot>
    </field>
</record>

<record id="olive_oil_analysis_line_action" model="ir.actions.act_window">
    <field name="name">Oil Analysis Lines</field>
    <field name="res_model">olive.oil.analysis.line</field>
    <field name="view_mode">pivot,list,form</field>
    <field name="context">{'search_default_current_season': True, 'search_default_done': True, 'olive_oil_analysis_line_main_view': True}</field>
</record>

<menuitem id="olive_oil_analysis_line_menu" action="olive_oil_analysis_line_action" parent="olive_report_menu" sequence="100"/>

</odoo>
