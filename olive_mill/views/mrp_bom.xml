<odoo>

<record id="view_mrp_bom_filter" model="ir.ui.view">
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.view_mrp_bom_filter"/>
    <field name="arch" type="xml">
        <filter name="inactive" position="after">
            <separator/>
            <filter string="Olive Products" name="olive_products" domain="[('product_tmpl_id.detailed_type', '=like', 'olive_%')]"/>
        </filter>
    </field>
</record>

<record id="olive_mrp_bom_action" model="ir.actions.act_window">
    <field name="name">Bills of Materials</field>
    <field name="res_model">mrp.bom</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">{'search_default_olive_products': True}</field>
</record>

<menuitem id="olive_mrp_bom_menu" action="olive_mrp_bom_action" sequence="110" parent="olive_data_menu"/>

</odoo>
