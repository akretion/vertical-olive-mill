<?xml version='1.0' encoding='utf-8'?>
<odoo>


<record id="olive_appointment_action" model="ir.actions.act_window">
    <field name="name">Appointments</field>
    <field name="res_model">olive.appointment</field>
    <field name="view_mode">calendar,list,form</field>
    <field name="context">{'search_default_current_season': 1}</field>
</record>

<record id="olive_appointment_tree_action" model="ir.actions.act_window">
    <field name="name">Appointments</field>
    <field name="res_model">olive.appointment</field>
    <field name="view_mode">list,form,calendar</field>
    <field name="context">{'search_default_current_season': 1}</field>
</record>


<record id="olive_appointment_form" model="ir.ui.view">
    <field name="name">olive.appointment.form</field>
    <field name="model">olive.appointment</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="%(olive_palox_lend_action)d" type="action" string="Lend Palox/Cases" invisible="appointment_type != 'lend'" context="{'default_partner_id': partner_id, 'default_regular_case_qty': lend_regular_case_qty, 'default_organic_case_qty': lend_organic_case_qty}" class="btn-primary"/>
                <button name="open_arrival" class="btn-primary" invisible="appointment_type not in ('arrival_leaf_removal', 'arrival_no_leaf_removal')" string="Arrival" type="object"/>
                <button name="open_new_appointment" invisible="appointment_type not in ('arrival_leaf_removal', 'arrival_no_leaf_removal')" string="New Appointment" type="object"/>
                <button name="%(olive_withdrawal_action)d" type="action" string="New Withdrawal" invisible="appointment_type != 'withdrawal'" context="{'default_partner_id': partner_id}" class="btn-primary"/>
                <button name="%(olive_invoice_create_action)d" type="action" string="Create Invoice" invisible="appointment_type != 'withdrawal'" context="{'default_partner_id': partner_id}"/>
            </header>
            <sheet>
                <div name="button_box" class="oe_button_box">
                    <span name="olive_cultivation_form_ko" invisible="not olive_cultivation_form_ko or not partner_id" class="badge rounded-pill text-bg-danger font-weight-bold">Cultivation form missing</span>
                    <span name="olive_parcel_ko" invisible="not olive_parcel_ko or not partner_id" class="badge rounded-pill text-bg-warning font-weight-bold">Parcel information incomplete</span>
                    <span name="olive_organic_certif_ko" invisible="not olive_organic_certif_ko or not partner_id" class="badge rounded-pill text-bg-success font-weight-bold" groups="olive_mill.olive_organic">Organic certification missing</span>
                    <span name="olive_invoicing_ko" invisible="not olive_invoicing_ko or not partner_id" class="badge rounded-pill text-bg-info font-weight-bold">Invoicing to do</span>
                    <span name="olive_withdrawal_ko" invisible="not olive_withdrawal_ko or not partner_id" class="badge rounded-pill text-bg-dark font-weight-bold">Pending Withdrawal</span>
                    <button class="oe_stat_button" type="object" name="show_arrival_appointments_same_day" icon="fa-arrow-down">  <!-- use fa-tractor when we'll have access to FA 5.4 -->
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field name="total_qty_same_day" widget="statinfo" nolabel="1"/>
                                kg
                            </span>
                            <span class="o_stat_text">Olives that day</span>
                        </div>
                    </button>
                    <button class="oe_stat_button" type="object" name="show_arrival_appointments_same_day" icon="fa-stop">  <!-- use fa-tractor when we'll have access to FA 5.4 -->
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field name="total_palox_same_day" widget="statinfo" nolabel="1"/>
                            </span>
                            <span class="o_stat_text">Palox that day</span>
                        </div>
                    </button>
                    <button name="open_new_appointment_after_this" string="New After This" type="object" icon="fa-angle-double-right" class="oe_stat_button"/>
                </div>
                <img src="/olive_mill/static/image/organic_logo_done.png" alt="Logo Organic" invisible="olive_culture_type != 'organic' or olive_organic_certif_ko" height="40"/>
                <img src="/olive_mill/static/image/organic_logo_draft.png" alt="Logo Organic Draft" invisible="olive_culture_type != 'organic' or not olive_organic_certif_ko" height="40"/>
                <img src="/olive_mill/static/image/organic_logo_conversion_done.png" alt="Logo Conversion" invisible="olive_culture_type != 'conversion' or olive_organic_certif_ko" height="40"/>
                <img src="/olive_mill/static/image/organic_logo_conversion_draft.png" alt="Logo Conversion Draft" invisible="olive_culture_type != 'conversion' or not olive_organic_certif_ko" height="40"/>
                <group name="main">
                    <group name="top-left">
                        <field name="partner_id"/>
                        <field name="appointment_type"/>
                        <field name="name"/>
                        <field name="commercial_partner_id" invisible="1"/>
                        <field name="olive_culture_type" invisible="1"/>
                        <field name="olive_cultivation_form_ko" invisible="1"/>
                        <field name="olive_parcel_ko" invisible="1"/>
                        <field name="olive_organic_certif_ko" invisible="1"/>
                        <field name="olive_invoicing_ko" invisible="1"/>
                        <field name="olive_withdrawal_ko" invisible="1"/>
                    </group>
                    <group name="top-right">
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="season_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date" invisible="1"/>
                    </group>
                    <group name="arrival" invisible="appointment_type not in ('arrival_leaf_removal', 'arrival_no_leaf_removal')">
                        <field name="variant_id" widget="selection"/>
                        <label for="qty"/>
                        <div name="qty">
                            <field name="qty" class="oe_inline"/> kg
                        </div>
                        <field name="palox_qty"/>
                        <field name="oil_product_id" widget="selection"/>
                        <field name="oil_destination"/>
                        <label for="withdrawal_oil_qty" invisible="oil_destination != 'mix'"/>
                        <div name="withdrawal_oil_qty" invisible="oil_destination != 'mix'">
                            <field name="withdrawal_oil_qty" class="oe_inline"/> L
                        </div>
                    </group>
                    <group name="withdrawal" invisible="appointment_type != 'withdrawal'">
                        <field name="withdrawal_invoice" widget="radio" string="Withdrawal"/>
                    </group>
                    <group name="lend" invisible="appointment_type != 'lend'">
                        <field name="lend_palox_qty"/>
                        <field name="lend_regular_case_qty" readonly="olive_culture_type in ('organic', 'conversion')"/>
                        <field name="lend_organic_case_qty" readonly="olive_culture_type == 'regular'" groups="olive_mill.olive_organic"/>
                    </group>
                </group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<record id="olive_appointment_tree" model="ir.ui.view">
    <field name="name">olive.appointment.tree</field>
    <field name="model">olive.appointment</field>
    <field name="arch" type="xml">
        <list>
            <field name="day_of_week_sel"/>
            <field name="start_datetime"/>
            <field name="end_datetime"/>
            <field name="appointment_type" widget="badge" decoration-info="appointment_type == 'withdrawal'" decoration-warning="appointment_type == 'arrival_no_leaf_removal'" decoration-danger="appointment_type == 'arrival_leaf_removal'" decoration-success="appointment_type == 'lend'"/>
            <field name="partner_id"/>
            <field name="commercial_partner_id" invisible="1"/>
            <field name="variant_id" optional="show"/>
            <field name="qty" sum="1"/>
            <field name="palox_qty" sum="1"/>
            <field name="oil_destination" optional="show"/>
            <field name="withdrawal_oil_qty" optional="hide"/>
        </list>
    </field>
</record>

<record id="olive_appointment_calendar" model="ir.ui.view">
    <field name="name">olive.appointment.calendar</field>
    <field name="model">olive.appointment</field>
    <field name="arch" type="xml">
        <!-- color="appointment_type" doesn't work on a selection field, only a M2O field -->
        <calendar date_start="start_datetime" date_stop="end_datetime" mode="month">
            <field name="display_calendar_label"/>
            <field name="appointment_type" filters="1" invisible="1"/>
        </calendar>
    </field>
</record>

