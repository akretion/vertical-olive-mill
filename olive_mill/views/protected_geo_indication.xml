<odoo>

        <record id="protected_geo_indication_form" model="ir.ui.view">
                <field name="model">protected.geo.indication</field>
                <field name="arch" type="xml">
                        <form>
                                <sheet>
                                        <widget
                    name="web_ribbon"
                    title="Archived"
                    bg_color="bg-danger"
                                                attrs="{'invisible': [('active', '=', True)]}" />
                                        <div class="oe_button_box" name="button_box">
                                                <button class="oe_stat_button" type="action"
                        name="%(olive_mill.olive_ochard_action)d"
                        context="{'search_default_geo_id': active_id}"
                        icon="fa-pagelines">
                        <field string="Ochards" name="ochard_count" widget="statinfo"/>
                </button>
                                                <button class="oe_stat_button" type="action"
                        name="%(olive_mill.olive_product_template_action)d"
                        context="{'search_default_olive_geo_id': active_id}"
                        icon="fa-shopping-basket">
                        <field string="Products" name="product_template_count" widget="statinfo"/>
                    </button>

                </div>
                    <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                                <group name="main">
                                        <field name="code"/>
                                        <field name="active" invisible="1"/>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                        </sheet>
                        </form>
                </field>
        </record>

    <record id="protected_geo_indication_tree" model="ir.ui.view">
                <field name="model">protected.geo.indication</field>
                <field name="arch" type="xml">
                        <tree>
                                        <field name="sequence" widget="handle"/>
                                        <field name="code"/>
                                        <field name="name" decoration-bf="1"/>
                                        <field name="active" invisible="1"/>
                                        <field name="company_id" groups="base.group_multi_company" optional="show"/>
                        </tree>
                </field>
        </record>

    <record id="protected_geo_indication_search" model="ir.ui.view">
                <field name="model">protected.geo.indication</field>
                <field name="arch" type="xml">
                    <search>
                            <field name="name" string="Name or Code" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                            <separator/>
                            <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </search>
                </field>
        </record>

        <record id="protected_geo_indication_action" model="ir.actions.act_window">
                <field name="name">Protected Geographical Indication</field>
                <field name="res_model">protected.geo.indication</field>
                <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="protected_geo_indication_menu" action="protected_geo_indication_action" sequence="60" parent="olive_config_menu" groups="olive_protected_geo_indication"/>

</odoo>
