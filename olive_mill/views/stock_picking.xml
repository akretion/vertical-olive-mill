<odoo>


<record id="view_picking_form" model="ir.ui.view">
    <field name="name">olive.mill.stock.picking.form</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
        <button name="action_cancel" position="before">
            <button name="start_olive_oil_picking_wizard" string="Get Loose Olive Oil" type="object" attrs="{'invisible': [('olive_oil_picking_wizard_next_move_id', '=', False)]}" />
        </button>
        <field name="priority" position="after">
            <field name="olive_oil_picking_wizard_next_move_id" invisible="1"/>
            <field name="olive_withdrawal" invisible="1"/>
        </field>
        <button name="%(stock.action_report_delivery)d" type="action" position="attributes">
            <attribute name="attrs">{'invisible': ['|', ('olive_withdrawal', '=', True), ('state', '!=', 'done')]}</attribute>
        </button>
        <button name="%(stock.action_report_delivery)d" type="action" position="after">
            <button name="%(olive_oil_delivery_report)d" string="Print Oil Withdrawal" attrs="{'invisible': ['|', ('olive_withdrawal', '=', False), ('state', '!=', 'done')]}" type="action" groups="base.group_user"/>
        </button>
    </field>
</record>


</odoo>
